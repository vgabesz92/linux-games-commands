{
    "name": "gabeszm/flarum-linux-games-commands",
    "description": "Flarum extension for Linux gaming commands and presets",
    "version": "0.1.0",
    "type": "flarum-extension",
    "keywords": [
        "flarum",
        "linux",
        "gaming",
        "commands"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "gabeszm"
        }
    ],
    "require": {
        "flarum/core": "^2.0.0-beta || ^2.0.0-rc.1 || ^2.0.0"
    },
    "autoload": {
        "psr-4": {
            "Gabeszm\\LinuxGamesCommands\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Linux Games Commands",
            "category": "feature",
            "icon": {
                "name": "fas fa-gamepad",
                "backgroundColor": "#171a21",
                "color": "#66c0f4"
            }
        }
    }
}
